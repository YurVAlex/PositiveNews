@model PositiveNews.Web.Models.TopicsPartialViewModel

@if (Model.Topics != null && Model.Topics.Any())
{
    <div class="d-flex flex-wrap gap-1 mb-2">
        @foreach (var topic in Model.Topics.Distinct())
        {
            var isActive = topic.Equals(Model.SelectedTopic, StringComparison.OrdinalIgnoreCase);
            var btnClass = isActive ? "btn btn-primary btn-sm" : "btn btn-outline-dark btn-sm";

            <a asp-action="Index"
                   asp-route-topic="@topic"
                   asp-route-page="1"
                   class="@btnClass"
                   style="font-size: 0.85rem;">
                @topic
            </a>
        }
    </div>
}