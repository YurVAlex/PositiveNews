@model PositiveNews.Web.Models.ArticleDetailViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="text-decoration-none mb-4 d-inline-block">&larr; Back to Feed</a>
                <div>
                    @if (!string.IsNullOrEmpty(@Model.SourceLogoUrl))
                    {
                        <img src="@Model.SourceLogoUrl"
                             alt="@Model.SourceName"
                             class="border-light me-2"
                             style="width: 32px; height: 32px; object-fit: cover;" />
                    }
                    <span class="fw-bold me-2">@Model.SourceName</span>
                </div>
            </div>
            

            <h1 class="fw-bold mb-3">@Model.Title</h1>

            <div class="d-flex align-items-center text-muted mb-4 border-bottom pb-3">
                •
                <span class="mx-2">@(string.IsNullOrEmpty(Model.Author) ? "Unknown Author" : Model.Author)</span> •
                <span class="ms-2">@Model.PublishedAt.ToString("MMMM dd, yyyy - HH:mm")</span>
            </div>

            <div class="article-content fs-5" style="line-height: 1.8;">
                @if (!string.IsNullOrEmpty(Model.ContentHtml))
                {
                    @Html.Raw(Model.ContentHtml)
                }
                else
                {
                    <div class="alert alert-warning">
                        Full content is not available for this article yet.
                    </div>
                }
                </div>
            </div>
        </div>
    </div>
</div>