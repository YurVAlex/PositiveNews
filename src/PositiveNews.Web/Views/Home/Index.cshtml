@model PositiveNews.Web.Models.FeedIndexViewModel

@{
    ViewData["Title"] = "Positive News Feed";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4">Latest Positive News</h2>

            @for (int i = 0; i < Model.Articles.Count; i++)
            {
                var article = Model.Articles[i];

                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-white d-flex align-items-center border-0 pb-0">
                        @if (!string.IsNullOrEmpty(article.SourceLogoUrl))
                        {
                            <img src="@article.SourceLogoUrl"
                                 alt="@article.SourceName"
                                 class="border-light me-2"
                                 style="width: 32px; height: 32px; object-fit: cover;" />
                        }
    
                        <span class="fw-bold text-muted fs-5">@article.SourceName</span>
                    </div>

                    <div class="card-body">
                        <h4 class="card-title fw-bold">@article.Title</h4>

                        <h6 class="card-subtitle mb-3 text-muted">
                            @(string.IsNullOrEmpty(article.Author) ? "Unknown Author" : article.Author) • @article.PublishedAt.ToString("MMM dd, yyyy")
                        </h6>

                        <article-img image-tag="@article.ImageTag" index="@i"></article-img>

                        <!-- Topics Section -->
                        <partial name="_TopicsPartial" model="article.Topics" />

                        <div class="d-flex gap-2 mb-2 mt-3">
                            <button class="btn btn-outline-secondary" onclick="toggleSummary('summary-@article.Id')">Show summary</button>
                            <a asp-action="ReadArticle" asp-route-id="@article.Id" class="btn btn-primary">Read article</a>
                        </div>

                        <div id="summary-@article.Id" class="mt-3 p-3 bg-light rounded d-none">
                            <strong>Summary:</strong>
                            <p class="mb-0">@article.SummaryShort</p>
                        </div>
                    </div>
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
                        </li>
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleSummary(elementId) {
            var el = document.getElementById(elementId);
            if (el.classList.contains('d-none')) {
                el.classList.remove('d-none');
            } else {
                el.classList.add('d-none');
            }
        }
    </script>
}
