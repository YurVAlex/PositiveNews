@model PositiveNews.Web.Models.FeedIndexViewModel

@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.SelectedTopic)
        ? "Positive News Feed"
        : $"Articles - {Model.SelectedTopic}";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-12">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    @(string.IsNullOrEmpty(Model.SelectedTopic)
                        ? "Latest Positive News"
                        : $"Topic: {Model.SelectedTopic}")
                </h2>

                @if (!string.IsNullOrEmpty(Model.SelectedTopic))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        ✕ Clear Filter
                    </a>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.SelectedTopic))
            {
                <div class="alert alert-info mb-4">
                    Showing articles with topic <strong>@Model.SelectedTopic</strong> first.
                </div>
            }

            <!-- Articles -->
            @for (int i = 0; i < Model.Articles.Count; i++)
            {
                var article = Model.Articles[i];

                <div class="card mb-4 shadow-sm">

                    <!-- Header -->
                    <div class="card-header bg-white d-flex align-items-center border-0 pb-0">
                        @if (!string.IsNullOrEmpty(article.SourceLogoUrl))
                        {
                            <img src="@article.SourceLogoUrl"
                                 alt="@article.SourceName"
                                 class="me-2"
                                 style="width: 32px; height: 32px; object-fit: cover;" />
                        }

                        <span class="fw-bold text-muted fs-5">@article.SourceName</span>
                    </div>

                    <!-- Body -->
                    <div class="card-body">
                        <h4 class="card-title fw-bold">@article.Title</h4>

                        <h6 class="card-subtitle mb-3 text-muted">
                            @(string.IsNullOrEmpty(article.Author)
                                ? "Unknown Author"
                                : article.Author)
                            • @article.PublishedAt.ToString("MMM dd, yyyy")
                        </h6>

                        <article-img image-tag="@article.ImageTag" index="@i"></article-img>

                        <!-- Topics -->
                        <partial name="_TopicsPartial"
                                 model="new PositiveNews.Web.Models.TopicsPartialViewModel
                                                         {
                                                             Topics = article.Topics,
                                                             SelectedTopic = Model.SelectedTopic
                                                         }" />

<!-- Actions -->
<div class="d-flex gap-2 mt-3">
                            <button class="btn btn-outline-secondary"
                                    onclick="toggleSummary('summary-@article.Id')">
                                Show summary
                            </button>

                            <a asp-action="ReadArticle"
                                   asp-route-id="@article.Id"
                                   class="btn btn-primary">
                                Read article
                            </a>
                        </div>

                        <!-- Summary -->
                        <div id="summary-@article.Id"
                             class="mt-3 p-3 bg-light rounded d-none">
                            <strong>Summary:</strong>
                            <p class="mb-0">@article.SummaryShort</p>
                        </div>
                    </div>
                </div>
            }

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">

                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-topic="@Model.SelectedTopic">
                                Previous
                            </a>
                        </li>

                        <li class="page-item disabled">
                            <span class="page-link">
                                Page @Model.CurrentPage of @Model.TotalPages
                            </span>
                        </li>

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-topic="@Model.SelectedTopic">
                                Next
                            </a>
                        </li>

                    </ul>
                </nav>
            }

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleSummary(id) {
            var el = document.getElementById(id);
            el.classList.toggle('d-none');
        }
    </script>
}