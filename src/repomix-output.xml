                </div>

                {selectedUserId === null ? (
                  <p className="text-muted">Select a user to review and update account state.</p>
                ) : detailLoading ? (
                  <p className="text-muted">Loading user details…</p>
                ) : selectedUserDetail === null ? (
                  <p className="text-muted">No user details available.</p>
